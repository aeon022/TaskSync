/* Colors come from the active Textual theme ($primary, $background, ...), switch with :theme */

Screen {
    background: $background;
    color: $foreground;
    layers: default overlay;
}

/* Minimalist Scrollbar - Cursor Block Style */
* {
    scrollbar-size: 1 1;
    scrollbar-color: $border-blurred;
    scrollbar-color-hover: $primary;
    scrollbar-color-active: $primary;
    scrollbar-background: transparent;
}

#header-stats {
    height: 4;
    background: $background;
    color: $primary;
    align: center middle;
    padding: 0 2;
    overflow: hidden;
    border-bottom: solid $border-blurred;
}
#header-title { width: auto; color: $primary; }
#header-stats Sparkline { width: 24; height: 1; margin: 0 3; }
#header-status { width: auto; color: $text-muted; }

#app-grid {
    layout: grid;
    grid-size: 3;
    grid-columns: 30 1fr 34;
    height: 1fr;
    padding: 0 1;
    overflow: hidden;
    align: center top;
}

/* Thin Border Panels with Fieldset Look */
#sidebar, #main-content, #details-panel {
    border: solid $border-blurred;
    background: transparent;
    height: 100%;
    margin: 0;
    padding-top: 1; /* Increase distance between header title and content */
}

#sidebar, #main-content, #details-panel {
    border-title-color: $primary;
    border-title-style: bold;
}
#task-list { background: transparent; }
#task-list > ListItem.-highlight { background: $primary 25%; }
#task-list:focus > ListItem.-highlight { background: $primary 40%; }
#list-tree > .tree--cursor { background: $primary 30%; color: $foreground; text-style: bold; }
#list-tree:focus > .tree--cursor { background: $primary 45%; }
Footer { background: $background; color: $text-muted; scrollbar-size-horizontal: 0; }
Footer .footer-key--key { color: $primary; background: $background; text-style: bold; }
Footer .footer-key--description { color: $text-muted; background: $background; }

#sidebar {
    border-right: none;
}

#details-panel {
    border-left: none;
}

#details-content {
    background: transparent;
    padding: 1 2;
}

/* Remove separate panel headers, we use border-title now */
.panel-header {
    display: none;
}

.hidden {
    display: none;
}

#add-task-input {
    margin: 1 1;
    border: solid $primary;
    background: $background;
}

/* List Item - Clean & High Contrast */
ListItem {
    padding: 0;
    background: transparent;
    transition: background 100ms;
    height: 1;
}

ListItem.visual-selected {
    background: $primary 30%;
    color: white;
    text-style: bold italic;
}

ListItem.selected {
    background: $primary 10%;
}

/* Task Priority Indicators */
.prio-high { color: $error; text-style: bold; }
.prio-med { color: $warning; }
.prio-low { color: $secondary; }

/* Fixed Contrast for Completed Tasks */
.completed-task {
    color: $text-muted; /* Mid-gray, readable but clearly "done" */
    text-style: strike;
}

#list-tree {
    background: transparent;
    color: $foreground;
    padding: 0;
}

#list-tree > .tree--root {
    display: none;
}

Tree:focus {
    border: none;
}

Tree .tree--guides {
    color: $border-blurred;
}

/* Animated Command Bar */
#command-container {
    dock: bottom;
    layout: horizontal;
    height: 1;
    background: $primary;
    color: $background;
    offset-y: 100%;
    layer: overlay;
    transition: offset 150ms in_out_cubic;
}

#command-container.visible {
    offset-y: 0;
}

#command-prefix {
    width: 3;
    text-style: bold;
    content-align: center middle;
}

#command-input {
    width: 1fr;
    background: $background;
    color: $foreground;
    border: none;
    padding: 0 1;
}

/* Modals with Thin Borders */
ModalScreen { align: center middle; background: $background 70%; }
#focus-dialog, #insights-dialog, #fuzzy-dialog, #help-dialog, #setup-dialog, #add-dialog {
    background: $background;
    border: round $primary;
    width: 90%;
    max-width: 84;
    height: 85%;
    max-height: 30;
    padding: 1 2;
}
#focus-header, #insights-header, #fuzzy-header, #help-header, #setup-header, #add-header {
    width: 100%;
    color: $primary;
    text-style: bold;
    margin-bottom: 1;
}
#help-scroll, #insights-scroll { height: 1fr; }
#help-dialog MarkdownH1, #help-dialog MarkdownH2, #help-dialog MarkdownH3,
#insights-dialog MarkdownH1, #insights-dialog MarkdownH2 { color: $primary; text-style: bold; text-align: left; content-align: left middle; }
#help-dialog MarkdownBlock Link, #insights-dialog Link { color: $secondary; }

#fuzzy-input {
    background: $background;
    border: solid $border-blurred;
    margin-bottom: 1;
}

#fuzzy-results {
    height: 1fr;
    background: transparent;
    border: none;
}

.large-timer {
    width: 100%;
    height: 1fr;
    text-align: center;
    content-align: center middle;
    text-style: bold;
    color: $warning;
    background: $background;
    border: solid $border-blurred;
    margin-bottom: 1;
}

#focus-footer, #insights-footer, #fuzzy-footer {
    width: 100%;
    text-align: center;
    color: $text-muted;
}
/* Narrow terminals: drop the details panel, then shrink the sidebar */
.narrow #app-grid { grid-size: 2; grid-columns: 28 1fr; }
.narrow #details-panel { display: none; }
.tiny #app-grid { grid-size: 2; grid-columns: 20 1fr; }
.tiny #details-panel { display: none; }

#header-stats Sparkline > .sparkline--max-color { color: $primary; }
#header-stats Sparkline > .sparkline--min-color { color: $border-blurred; }

#details-content MarkdownH1 { color: $primary; text-align: left; content-align: left middle; text-style: bold; margin: 0 0 1 0; }
#details-content MarkdownHorizontalRule { color: $border-blurred; }
#list-tree { scrollbar-size-horizontal: 0; overflow-x: hidden; }
TaskItem Label { background: transparent; width: 1fr; padding: 0 2; text-wrap: nowrap; text-overflow: ellipsis; }

/* Setup assistant */
#setup-dialog, #add-dialog { height: auto; max-height: 90%; }
#setup-intro { color: $text-muted; margin-bottom: 1; }
#setup-list { height: auto; max-height: 12; background: transparent; border: none; margin-bottom: 1; }
#setup-footer { width: 100%; text-align: center; color: $text-muted; margin-top: 1; }
#add-dialog Select, #add-dialog Input { margin-bottom: 1; }
#add-status { min-height: 3; margin-bottom: 1; }
#add-buttons { height: auto; align-horizontal: right; }
#add-buttons Button { margin-left: 2; }
