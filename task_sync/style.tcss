/* Catppuccin Mocha Palette - Elite Edition */
$base: #030303; /* Deeper black for higher contrast */
$mantle: #0b0b0b;
$crust: #000000;
$text: #cdd6f4;
$subtext1: #bac2de;
$subtext0: #a6adc8;
$overlay2: #9399b2;
$overlay1: #7f849c;
$overlay0: #6c7086;
$surface2: #585b70;
$surface1: #45475a;
$surface0: #313244;
$mauve: #cba6f7;
$blue: #89b4fa;
$green: #a6e3a1;
$red: #f38ba8;
$peach: #fab387;
$yellow: #f9e2af;

Screen {
    background: $base;
    color: $text;
    layers: default overlay;
}

/* Minimalist Scrollbar - Cursor Block Style */
* {
    scrollbar-size: 1 1;
    scrollbar-color: $surface2;
    scrollbar-color-hover: $mauve;
    scrollbar-color-active: $mauve;
    scrollbar-background: transparent;
}

#header-stats {
    height: 4;
    background: $crust;
    color: $mauve;
    align: center middle;
    padding: 0 2;
    overflow: hidden;
    border-bottom: solid $surface1;
}
#header-title { width: auto; color: $mauve; }
#header-stats Sparkline { width: 24; height: 1; margin: 0 3; }
#header-status { width: auto; color: $subtext0; }

#app-grid {
    layout: grid;
    grid-size: 3;
    grid-columns: 30 1fr 34;
    height: 1fr;
    padding: 0 1;
    overflow: hidden;
    align: center top;
}

/* Thin Border Panels with Fieldset Look */
#sidebar, #main-content, #details-panel {
    border: solid $surface1;
    background: transparent;
    height: 100%;
    margin: 0;
    padding-top: 1; /* Increase distance between header title and content */
}

#sidebar, #main-content, #details-panel {
    border-title-color: $mauve;
    border-title-style: bold;
}
#task-list { background: transparent; }
#task-list > ListItem.-highlight { background: $mauve 25%; }
#task-list:focus > ListItem.-highlight { background: $mauve 40%; }
#list-tree > .tree--cursor { background: $mauve 30%; color: $text; text-style: bold; }
#list-tree:focus > .tree--cursor { background: $mauve 45%; }
Footer { background: $crust; color: $overlay1; scrollbar-size-horizontal: 0; }
Footer .footer-key--key { color: $mauve; background: $crust; text-style: bold; }
Footer .footer-key--description { color: $subtext0; background: $crust; }

#sidebar {
    border-right: none;
}

#details-panel {
    border-left: none;
}

#details-content {
    background: transparent;
    padding: 1 2;
}

/* Remove separate panel headers, we use border-title now */
.panel-header {
    display: none;
}

.hidden {
    display: none;
}

#add-task-input {
    margin: 1 1;
    border: solid $mauve;
    background: $crust;
}

/* List Item - Clean & High Contrast */
ListItem {
    padding: 0;
    background: transparent;
    transition: background 100ms;
    height: 1;
}

ListItem.visual-selected {
    background: $mauve 30%;
    color: white;
    text-style: bold italic;
}

ListItem.selected {
    background: $mauve 10%;
}

/* Task Priority Indicators */
.prio-high { color: $red; text-style: bold; }
.prio-med { color: $peach; }
.prio-low { color: $blue; }

/* Fixed Contrast for Completed Tasks */
.completed-task {
    color: $overlay1; /* Mid-gray, readable but clearly "done" */
    text-style: strike;
}

#list-tree {
    background: transparent;
    color: $text;
    padding: 0;
}

#list-tree > .tree--root {
    display: none;
}

Tree:focus {
    border: none;
}

Tree .tree--guides {
    color: $surface1;
}

/* Animated Command Bar */
#command-container {
    dock: bottom;
    layout: horizontal;
    height: 1;
    background: $mauve;
    color: $crust;
    offset-y: 100%;
    layer: overlay;
    transition: offset 150ms in_out_cubic;
}

#command-container.visible {
    offset-y: 0;
}

#command-prefix {
    width: 3;
    text-style: bold;
    content-align: center middle;
}

#command-input {
    width: 1fr;
    background: $crust;
    color: $text;
    border: none;
    padding: 0 1;
}

/* Modals with Thin Borders */
ModalScreen { align: center middle; background: $crust 70%; }
#focus-dialog, #insights-dialog, #fuzzy-dialog, #help-dialog {
    background: $base;
    border: round $mauve;
    width: 90%;
    max-width: 84;
    height: 85%;
    max-height: 30;
    padding: 1 2;
}
#focus-header, #insights-header, #fuzzy-header, #help-header {
    width: 100%;
    color: $mauve;
    text-style: bold;
    margin-bottom: 1;
}
#help-scroll, #insights-scroll { height: 1fr; }
#help-dialog MarkdownH1, #help-dialog MarkdownH2, #help-dialog MarkdownH3,
#insights-dialog MarkdownH1, #insights-dialog MarkdownH2 { color: $mauve; text-style: bold; text-align: left; content-align: left middle; }
#help-dialog MarkdownBlock Link, #insights-dialog Link { color: $blue; }

#fuzzy-input {
    background: $crust;
    border: solid $surface1;
    margin-bottom: 1;
}

#fuzzy-results {
    height: 1fr;
    background: transparent;
    border: none;
}

.large-timer {
    width: 100%;
    height: 1fr;
    text-align: center;
    content-align: center middle;
    text-style: bold;
    color: $peach;
    background: $crust;
    border: solid $surface1;
    margin-bottom: 1;
}

#focus-footer, #insights-footer, #fuzzy-footer {
    width: 100%;
    text-align: center;
    color: $overlay0;
}

/* Theme Overrides - Macchiato (Mid Dark) */
.theme-macchiato {
    background: #24273a;
    color: #cad3f5;
}
.theme-macchiato #sidebar, .theme-macchiato #main-content, .theme-macchiato #details-panel { border: solid #494d64; }
.theme-macchiato .completed-task { color: #8087a2; }

/* Theme Overrides - Frappe (Soft Dark) */
.theme-frappe {
    background: #303446;
    color: #c6d0f5;
}
.theme-frappe #sidebar, .theme-frappe #main-content, .theme-frappe #details-panel { border: solid #51576d; }
.theme-frappe .completed-task { color: #838ba7; }

/* Theme Overrides - Latte (Light Mode) */
.theme-latte {
    background: #eff1f5;
    color: #4c4f69;
}
.theme-latte #header-stats { background: #dce0e8; border-bottom: solid #ccd0da; }
.theme-latte #sidebar, .theme-latte #main-content, .theme-latte #details-panel { border: solid #ccd0da; }
.theme-latte ListItem.selected { background: #8839ef 15%; }
.theme-latte .completed-task { color: #8c8fa1; }
.theme-latte #command-input { background: #e6e9ef; color: #4c4f69; }

/* Narrow terminals: drop the details panel, then shrink the sidebar */
.narrow #app-grid { grid-size: 2; grid-columns: 28 1fr; }
.narrow #details-panel { display: none; }
.tiny #app-grid { grid-size: 2; grid-columns: 20 1fr; }
.tiny #details-panel { display: none; }

#header-stats Sparkline > .sparkline--max-color { color: $mauve; }
#header-stats Sparkline > .sparkline--min-color { color: $surface2; }

#details-content MarkdownH1 { color: $mauve; text-align: left; content-align: left middle; text-style: bold; margin: 0 0 1 0; }
#details-content MarkdownHorizontalRule { color: $surface1; }
#list-tree { scrollbar-size-horizontal: 0; overflow-x: hidden; }
TaskItem Label { background: transparent; width: 1fr; padding: 0 2; text-wrap: nowrap; text-overflow: ellipsis; }
