---
const base = import.meta.env.BASE_URL;
---
<section id="terminal" class="max-w-5xl mx-auto mt-32 relative px-4 scroll-mt-32">
  <div class="text-center mb-16 opacity-0 translate-y-8 transition-all duration-700 reveal">
    <h2 class="text-3xl font-bold gradient-text mb-4">Command the flow.</h2>
    <p class="text-zinc-500 max-w-lg mx-auto">A full-screen terminal interface for speed. Vim-motions, global fuzzy search, due dates and over twenty themes, including one that uses your terminal's own colors.</p>
  </div>

  <div class="relative opacity-0 scale-95 transition-all duration-1000 delay-200 reveal">
    <div class="absolute -inset-10 bg-mauve/10 blur-3xl rounded-full -z-10 opacity-30"></div>
    <div class="bg-[#0b0b0b] border border-zinc-800 rounded-2xl overflow-hidden shadow-2xl shadow-black border-glow">
      <div class="bg-zinc-900/40 px-5 py-3 flex items-center border-b border-zinc-800/50">
        <div class="flex items-center gap-2">
          <div class="w-3 h-3 rounded-full bg-[#ff5f56]"></div>
          <div class="w-3 h-3 rounded-full bg-[#ffbd2e]"></div>
          <div class="w-3 h-3 rounded-full bg-[#27c93f]"></div>
          <span class="ml-3 text-[10px] font-mono text-zinc-600 tracking-widest uppercase">utask ui</span>
        </div>
      </div>
      <img src={`${base}img/ui-utask.png`} width="1400" height="710" loading="lazy" decoding="async"
        alt="The utask interface: lists of Apple, Google and Microsoft accounts on the left, tasks sorted by due date with overdue ones in red in the middle, details of the selected task on the right" class="hidden sm:block w-full h-auto" />
      <img src={`${base}img/ui-utask-narrow.png`} width="900" height="620" loading="lazy" decoding="async"
        alt="The utask interface in a narrow terminal: account lists on the left and tasks sorted by due date, overdue ones in red" class="block sm:hidden w-full h-auto" />
    </div>
  </div>

  <div class="mt-10 grid grid-cols-1 sm:grid-cols-2 gap-6 reveal opacity-0 translate-y-8 transition-all duration-700">
    <figure class="bg-[#0b0b0b] border border-zinc-800 rounded-xl overflow-hidden">
      <img src={`${base}img/ui-latte.png`} width="700" height="355" loading="lazy" decoding="async" alt="The same interface in the light Catppuccin Latte theme" class="block w-full h-auto" />
      <figcaption class="px-4 py-3 text-[11px] font-mono text-zinc-500"><span class="text-mauve">:theme latte</span> · light</figcaption>
    </figure>
    <figure class="bg-[#0b0b0b] border border-zinc-800 rounded-xl overflow-hidden">
      <img src={`${base}img/ui-nord.png`} width="700" height="355" loading="lazy" decoding="async" alt="The same interface in the Nord theme" class="block w-full h-auto" />
      <figcaption class="px-4 py-3 text-[11px] font-mono text-zinc-500"><span class="text-mauve">:theme nord</span> · or <span class="text-mauve">:theme terminal</span> to use your terminal's own colors</figcaption>
    </figure>
  </div>
</section>

<script>
  const observer = new IntersectionObserver((entries) => {
    entries.forEach(entry => {
      if (entry.isIntersecting) {
        entry.target.classList.add('opacity-100', 'translate-y-0', 'scale-100');
        entry.target.classList.remove('opacity-0', 'translate-y-8', 'scale-95');
      }
    });
  }, { threshold: 0.1 });

  document.querySelectorAll('.reveal').forEach(el => observer.observe(el));
</script>
